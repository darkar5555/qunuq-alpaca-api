# ── Servidor ─────────────────────────────────────────────
# Puerto donde escucha la API
PORT=3000

# ── Base de datos (PostgreSQL · Prisma) ──────────────────
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qunuq_alpaca?schema=public"

# ── CORS ─────────────────────────────────────────────────
# Origen(es) permitidos del ERP. Separar por comas si hay varios.
# Dev (Angular): http://localhost:4200  ·  Prod: https://erp.qunuqalpaca.com
CORS_ORIGIN="http://localhost:4200"

# ── Autenticación (JWT · Fase 1) ─────────────────────────
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1d"
