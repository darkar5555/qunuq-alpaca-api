# Copia este archivo como .env EN EL SERVIDOR (junto a docker-compose.yml).
# NO lo subas a git. Rellena los valores marcados.

# ── PostgreSQL (contenedor db) ──
POSTGRES_USER=qunuq
POSTGRES_PASSWORD=CAMBIA_ESTO_por_una_clave_larga
POSTGRES_DB=qunuq_alpaca

# ── Conexión de Prisma a la BD ──
# El host es "db" (nombre del servicio en docker-compose), NO localhost.
# La contraseña debe ser LA MISMA que POSTGRES_PASSWORD de arriba.
DATABASE_URL="postgresql://qunuq:CAMBIA_ESTO_por_una_clave_larga@db:5432/qunuq_alpaca?schema=public"

# ── CORS: dominios del frontend que pueden llamar a la API (coma-separado) ──
CORS_ORIGIN="https://qunuqalpaca.com,https://www.qunuqalpaca.com,https://erp.qunuqalpaca.com"

# ── JWT ──
# Genera un secreto fuerte con:  openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTO_por_un_secreto_aleatorio_largo
JWT_EXPIRES_IN=1d
