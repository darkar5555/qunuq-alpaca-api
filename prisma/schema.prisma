// Esquema de datos del ERP de Qunuq Alpaca.
// Mapea las entidades de PLAN-ERP.md. Nombres de tabla/columna en snake_case.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enumeraciones ────────────────────────────────────────

enum RolUsuario {
  ADMIN
  VENTAS
  PRODUCCION
}

enum TipoDocumento {
  DNI
  RUC
}

enum EstadoPedido {
  COTIZACION
  MUESTRA
  PRODUCCION
  ENTREGADO
}

enum TipoComprobante {
  FACTURA
  BOLETA
}

enum EstadoSunat {
  PENDIENTE
  ACEPTADO
  RECHAZADO
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  YAPE
  PLIN
}

enum EstadoSolicitud {
  NUEVA
  ATENDIDA
  CONVERTIDA
  DESCARTADA
}

// ── Acceso al ERP ────────────────────────────────────────

model Usuario {
  id           String     @id @default(uuid())
  nombre       String
  email        String     @unique
  passwordHash String     @map("password_hash")
  rol          RolUsuario @default(VENTAS)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("usuarios")
}

// ── Clientes ─────────────────────────────────────────────

model Cliente {
  id                 String        @id @default(uuid())
  tipoDocumento      TipoDocumento @map("tipo_documento")
  numeroDocumento    String        @map("numero_documento")
  nombreORazonSocial String        @map("nombre_o_razon_social")
  email              String?
  telefono           String?
  direccion          String?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  pedidos Pedido[]

  @@unique([tipoDocumento, numeroDocumento])
  @@map("clientes")
}

// ── Catálogo de productos ────────────────────────────────

model Producto {
  id          String   @id @default(uuid())
  nombre      String
  categoria   String // tela / punto / accesorio / hogar
  descripcion String?
  precioBase  Decimal  @map("precio_base") @db.Decimal(10, 2)
  unidad      String // metro, unidad, etc.
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items PedidoItem[]

  @@map("productos")
}

// ── Catálogos del configurador "Diseña tu tejido" ────────

model Fibra {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)

  items PedidoItem[]

  @@map("fibras")
}

model Color {
  id     String  @id @default(uuid())
  nombre String  @unique
  hex    String?
  activo Boolean @default(true)

  items PedidoItem[]

  @@map("colores")
}

model Tecnica {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)

  items PedidoItem[]

  @@map("tecnicas")
}

// ── Pedidos ──────────────────────────────────────────────

model Pedido {
  id        String       @id @default(uuid())
  codigo    String       @unique // correlativo interno
  clienteId String       @map("cliente_id")
  fecha     DateTime     @default(now())
  estado    EstadoPedido @default(COTIZACION)
  subtotal  Decimal      @default(0) @db.Decimal(10, 2)
  igv       Decimal      @default(0) @db.Decimal(10, 2)
  total     Decimal      @default(0) @db.Decimal(10, 2)
  notas     String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  cliente      Cliente       @relation(fields: [clienteId], references: [id])
  items        PedidoItem[]
  comprobantes Comprobante[]
  pagos        Pago[]

  @@map("pedidos")
}

model PedidoItem {
  id             String  @id @default(uuid())
  pedidoId       String  @map("pedido_id")
  productoId     String  @map("producto_id")
  fibraId        String? @map("fibra_id")
  colorId        String? @map("color_id")
  tecnicaId      String? @map("tecnica_id")
  cantidad       Decimal @db.Decimal(10, 2)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])
  fibra    Fibra?   @relation(fields: [fibraId], references: [id])
  color    Color?   @relation(fields: [colorId], references: [id])
  tecnica  Tecnica? @relation(fields: [tecnicaId], references: [id])

  @@map("pedido_items")
}

// ── Comprobantes (factura / boleta) ──────────────────────

model Comprobante {
  id           String          @id @default(uuid())
  pedidoId     String          @map("pedido_id")
  tipo         TipoComprobante
  serie        String
  numero       Int
  fechaEmision DateTime        @default(now()) @map("fecha_emision")
  estadoSunat  EstadoSunat     @default(PENDIENTE) @map("estado_sunat")
  igv          Decimal         @db.Decimal(10, 2)
  total        Decimal         @db.Decimal(10, 2)
  xmlUrl       String?         @map("xml_url")
  pdfUrl       String?         @map("pdf_url")
  cdr          String? // constancia de recepción de SUNAT
  createdAt    DateTime        @default(now()) @map("created_at")

  pedido Pedido @relation(fields: [pedidoId], references: [id])
  pagos  Pago[]

  @@unique([serie, numero])
  @@map("comprobantes")
}

// ── Pagos ────────────────────────────────────────────────

model Pago {
  id            String     @id @default(uuid())
  pedidoId      String?    @map("pedido_id")
  comprobanteId String?    @map("comprobante_id")
  monto         Decimal    @db.Decimal(10, 2)
  metodo        MetodoPago
  fecha         DateTime   @default(now())
  createdAt     DateTime   @default(now()) @map("created_at")

  pedido      Pedido?      @relation(fields: [pedidoId], references: [id])
  comprobante Comprobante? @relation(fields: [comprobanteId], references: [id])

  @@map("pagos")
}

// ── Inventario ───────────────────────────────────────────

model Insumo {
  id          String   @id @default(uuid())
  nombre      String
  tipo        String // fibra, hilo, etc.
  unidad      String // kg, conos, etc.
  stockActual Decimal  @default(0) @map("stock_actual") @db.Decimal(10, 2)
  stockMinimo Decimal  @default(0) @map("stock_minimo") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  movimientos MovimientoInventario[]

  @@map("insumos")
}

model MovimientoInventario {
  id         String         @id @default(uuid())
  insumoId   String         @map("insumo_id")
  tipo       TipoMovimiento
  cantidad   Decimal        @db.Decimal(10, 2)
  referencia String?
  fecha      DateTime       @default(now())
  createdAt  DateTime       @default(now()) @map("created_at")

  insumo Insumo @relation(fields: [insumoId], references: [id])

  @@map("movimientos_inventario")
}

// ── Contenido editable de la landing (mini CMS) ──────────

// Textos editables (hero, sobre nosotros, contacto, redes...).
// Modelo clave-valor: la landing lee por `clave`, el ERP edita por grupo.
model ContenidoSitio {
  id        String   @id @default(uuid())
  clave     String   @unique // p.ej. hero.titulo, contacto.telefono
  valor     String // el texto en sí
  grupo     String // hero | about | contacto | redes
  etiqueta  String // nombre legible para el ERP
  tipo      String   @default("texto") // texto | multilinea | url
  orden     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contenido_sitio")
}

// Imágenes del sitio (hero, galería, tarjetas de productos).
model ImagenSitio {
  id        String   @id @default(uuid())
  seccion   String // hero | galeria | producto
  url       String // ruta servida por la API (/uploads/...)
  titulo    String? // texto alternativo / descripción
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("imagenes_sitio")
}

// Solicitudes de cotización que llegan desde la landing (bandeja del ERP).
model Solicitud {
  id        String          @id @default(uuid())
  nombre    String
  email     String?
  telefono  String?
  interes   String? // tipo de tejido / interés
  mensaje   String?
  diseno    String? // resumen del configurador (fibra · color · técnica)
  origen    String          @default("formulario") // formulario | configurador
  estado    EstadoSolicitud @default(NUEVA)
  createdAt DateTime        @default(now()) @map("created_at")

  @@map("solicitudes")
}

// Tarjetas editables de la sección "Qué tejemos" de la landing.
model TarjetaProducto {
  id          String   @id @default(uuid())
  titulo      String
  descripcion String
  imagenUrl   String?  @map("imagen_url") // /uploads/.. o URL externa
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("tarjetas_producto")
}
